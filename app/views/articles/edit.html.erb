<h1>記事編集</h1>

<%= form_with model: @article do |form| %>
  <div>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, "本文" %><br>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.submit "更新する" %>
  </div>
<% end %>

<p>
  <%= link_to "詳細に戻る", article_path(@article) %>
  |
  <%= link_to "一覧に戻る", articles_path %>
</p>