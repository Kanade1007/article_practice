<h1>記事一覧</h1>

<% if flash[:notice] %>
  <p class="notice-message"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p class="alert-message"><%= flash[:alert] %></p>
<% end %>

<p>
  <%= link_to "新規投稿", new_article_path %>
</p>

<ul>
  <% @articles.each do |article| %>
    <li>
      <%= link_to article.title, article_path(article) %>
    </li>
  <% end %>
</ul>